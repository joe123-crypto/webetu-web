# =============================================================================
# Deploying on Vercel
# -----------------------------------------------------------------------------
# Set every non-derived var below in Vercel → Project → Settings → Environment
# Variables (scope: Production). Env changes only apply to NEW deployments, so
# redeploy after saving.
#
# Auto-derived on Vercel — do NOT set these to localhost; leave them UNSET and
# they resolve from the production domain (see src/config/index.ts →
# resolvePublicBaseUrl / VERCEL_PROJECT_PRODUCTION_URL):
#   - GOOGLE_REDIRECT_URI   → https://<domain>/auth/google/callback
#   - FIREBASE_EMAIL_LINK_URL → https://<domain>/auth/firebase/finish
# Setting PUBLIC_BASE_URL explicitly (recommended) removes any ambiguity.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   # or: openssl rand -base64 32
#
# Also required outside this file for the production domain to work:
#   - Google Cloud Console → OAuth client → add authorized redirect URI
#     https://<domain>/auth/google/callback and JS origin https://<domain>
#   - Firebase Console → Authentication → Settings → Authorized domains → add <domain>
# =============================================================================

# Firebase (server-side admin)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Firebase (client-side browser config)
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=1:123456789:web:abcdef
# Override if using a custom domain for email link sign-in:
FIREBASE_EMAIL_LINK_URL=https://www.webetu.app/auth/firebase/finish

# Encryption secrets
# IMPORTANT: CENTRAL_DATA_ENCRYPTION_SECRET must equal the value used by the
# reservation worker (agent_genaie) — they share the same encrypted Firestore data.
CENTRAL_DATA_ENCRYPTION_SECRET=a-strong-random-secret-min-32-chars
CENTRAL_DATA_KEY_VERSION=v1
TOKEN_ENCRYPTION_SECRET=another-strong-random-secret

# OAuth state HMAC signing. Only falls back to TOKEN_ENCRYPTION_SECRET when the
# var is ABSENT — an empty value does NOT fall back (config uses ?? not ||), so
# set a real value here.
OAUTH_STATE_SECRET=a-strong-random-secret

# Google OAuth (for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.webetu.app/auth/google/callback

# Internal API key (for server-to-server calls)
WEBETU_INTERNAL_API_KEY=

# Base URL of the backend worker / reservation read-API (bin/webetu-api),
# authed with WEBETU_INTERNAL_API_KEY. Used server-side to fetch a user's live
# ONOU restaurants, and proxied by GET /internal/health (bearer-authed) to report
# the reservation backend's run-status. Leave unset to fall back to the static
# restaurant catalog and mark the backend unreachable in the health check.
WEBETU_API_BASE_URL=http://127.0.0.1:8787

# Public base URL (used in OAuth redirect URIs and email links)
PUBLIC_BASE_URL=https://www.webetu.app
# For Open Graph / site metadata
NEXT_PUBLIC_SITE_URL=https://www.webetu.app

# Email delivery (choose one provider)
RESEND_API_KEY=
# Sender address — must be on a domain verified in Resend, e.g. "Webetu <no-reply@yourdomain.com>"
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Server binding (optional overrides)
HOST=127.0.0.1
PORT=3000
