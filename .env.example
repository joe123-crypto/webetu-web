# Firebase (server-side admin)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Firebase (client-side browser config)
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=1:123456789:web:abcdef
# Override if using a custom domain for email link sign-in:
FIREBASE_EMAIL_LINK_URL=https://www.webetu.app/auth/firebase/finish

# Encryption secrets
# IMPORTANT: CENTRAL_DATA_ENCRYPTION_SECRET must equal the value used by the
# reservation worker (agent_genaie) — they share the same encrypted Firestore data.
CENTRAL_DATA_ENCRYPTION_SECRET=a-strong-random-secret-min-32-chars
CENTRAL_DATA_KEY_VERSION=v1
TOKEN_ENCRYPTION_SECRET=another-strong-random-secret

# OAuth state HMAC signing (defaults to TOKEN_ENCRYPTION_SECRET if unset)
OAUTH_STATE_SECRET=

# Google OAuth (for Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.webetu.app/auth/google/callback

# Internal API key (for server-to-server calls)
WEBETU_INTERNAL_API_KEY=

# Public base URL (used in OAuth redirect URIs and email links)
PUBLIC_BASE_URL=https://www.webetu.app
# For Open Graph / site metadata
NEXT_PUBLIC_SITE_URL=https://www.webetu.app

# Email delivery (choose one provider)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Server binding (optional overrides)
HOST=127.0.0.1
PORT=3000
